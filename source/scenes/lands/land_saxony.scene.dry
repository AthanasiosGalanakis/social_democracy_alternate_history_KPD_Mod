view-if: x_saxony_defence = 1
choose-if: c_saxony_defence = 1
unavailable-subtitle: [? if d_saxony_cd > 0 : We acted here this turn. ?][? if d_saxony_cd <= 0 : Needs 1 resource and at least a thin organisation here. ?]
