view-if: x_berlin_border = 1
choose-if: c_berlin_border = 1
unavailable-subtitle: [? if d_berlin_cd > 0 : We acted here this turn. ?][? if d_berlin_cd <= 0 : Needs 1 resource and organisation 30 in Thuringia. ?]
