title: Next month
is-hand: true
on-arrival: {!
var adv_by = {right: ['thalheimer', 'walcher', 'radek', 'heckert'], centre: ['meyer', 'zetkin', 'pieck', 'eberlein'], left: ['fischer', 'maslow', 'thaelmann', 'scholem']};
var adv_in = 1, adv_ready = (Q.head_timer <= 0 ? 1 : 0);
for (var f of Q.kpd_factions) {
    if (Q['kf_' + f + '_strength'] > 0) {
        adv_in += 1;
        for (var a of adv_by[f]) { if (Q[a + '_timer'] <= 0) { adv_ready += 1; break; } }
    }
}
Q.pinnedCardsDescription = 'Chairman and faction advisers - ' + adv_ready + ' of ' + adv_in + ' can act.';
!}
max-cards: 4

- @party
- @mass
- #mapcard
- #advisor

@mass
title: Mass Work
is-deck: true

- #kpd_mass

@party
title: Party Affairs
is-deck: true

- #kpd_party
