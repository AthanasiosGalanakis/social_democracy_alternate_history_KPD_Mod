title: Next month
set-bg: img/map_2.jpg
is-hand: true
on-arrival: {!
var adv_ids = ['brandler', 'thalheimer', 'walcher', 'radek', 'pieck', 'meyer', 'zetkin', 'eberlein', 'fischer', 'maslow', 'thaelmann'];
var adv_in = 0, adv_ready = 0;
for (var a of adv_ids) {
    if (Q[a + '_advisor'] == 1) {
        adv_in += 1;
        if (Q[a + '_timer'] <= 0) { adv_ready += 1; }
    }
}
Q.pinnedCardsDescription = 'Advisors - ' + adv_ready + ' of ' + adv_in + ' ready to act.';
!}
max-cards: 3

#Here, the main deck will be displayed. Clicking on the deck draws a card into your hand. Clicking on a card activates that card.

- @party
- @mass
- #advisor
- @kpd_party_line

