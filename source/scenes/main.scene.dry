title: Next month
set-bg: img/map_2.jpg
is-hand: true
on-arrival: {!
var adv_by = {right: ['thalheimer', 'walcher', 'radek', 'heckert'], centre: ['meyer', 'zetkin', 'pieck', 'eberlein'], left: ['fischer', 'maslow', 'thaelmann', 'scholem']};
var adv_in = 1, adv_ready = (Q.head_timer <= 0 ? 1 : 0);
for (var f of Q.kpd_factions) {
    if (Q['kf_' + f + '_strength'] > 0) {
        adv_in += 1;
        for (var a of adv_by[f]) { if (Q[a + '_timer'] <= 0) { adv_ready += 1; break; } }
    }
}
Q.pinnedCardsDescription = 'Head of party and faction advisers - ' + adv_ready + ' of ' + adv_in + ' can act.';
!}
max-cards: 3

#Here, the main deck will be displayed. Clicking on the deck draws a card into your hand. Clicking on a card activates that card.

- @party
- @mass
- #advisor

