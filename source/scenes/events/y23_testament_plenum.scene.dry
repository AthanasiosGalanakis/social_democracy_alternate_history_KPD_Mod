    Q.kf_right_dissent += 10;
    Q.kf_centre_strength -= 10;
    Q.kf_centre_dissent += 10;
} else if (Q.testament_path == 2) {
    Q.y23_stalin_removed = 1;
    Q.moscow_balance = Math.min(Q.moscow_balance, 5);
    Q.moscow_drift = 0;
    Q.kf_right_strength += 18;
    Q.kf_left_dissent += 12;
