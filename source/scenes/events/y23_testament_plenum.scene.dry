} else if (Q.testament_path == 2) {
    Q.moscow_balance = Math.max(-100, Q.moscow_balance - 8);
    Q.comintern_trust -= 8;
} else {
    Q.moscow_balance = Math.max(-100, Q.moscow_balance - 5);
    Q.comintern_trust -= 10;
