title: Moscow's patience
subtitle: Our line is not the one the Comintern wants.
new-page: true
tags: kpd_event
view-if: moscow_step_pending = 1
on-arrival: {!
Q.moscow_step_pending = 0;
Q.moscow_divergence += 1;
Q.md_step = Q.moscow_divergence;
var names = {right: 'the Right', left: 'the Left', centre: 'the Centre', apparatus: 'the Moscow apparatus'};
Q.md_fav_name = names[Q.moscow_favored];
Q.md_expel = 0;
if (Q.md_step == 1) {
    Q.comintern_trust -= 5;
} else if (Q.md_step == 2) {
    Q.soviet_subsidy = 0;
    Q.comintern_trust -= 5;
} else if (Q.md_step == 3) {
    Q['kf_' + Q.moscow_favored + '_strength'] += 5;
    Q['kf_' + Q.party_line + '_dissent'] += 10;
} else if (Q.md_step == 4) {
    Q['kf_' + Q.party_line + '_dissent'] += 15;
    Q.comintern_trust -= 10;
} else if (Q.md_step >= 5) {
    Q.md_expel = 1;
    Q.md_old_name = names[Q.party_line];
    Q['kf_' + Q.party_line + '_dissent'] += 15;
    Q['kf_' + Q.party_line + '_strength'] = Q['kf_' + Q.party_line + '_strength']/2;
    Q.party_line = Q.moscow_favored;
    Q.party_line_months = 0;
    Q.party_line_changes += 1;
    Q.zigzag += 3;
    Q['kf_' + Q.party_line + '_dissent'] = Math.max(0, Q['kf_' + Q.party_line + '_dissent'] - 10);
    Q.moscow_divergence = 0;
    Q.moscow_divergence_pts = 0;
    Q.comintern_trust = Math.max(Q.comintern_trust, 30);
    Q.line_change_timer = 12;
}
!}

= Moscow's patience

[? if md_step = 1 : The ECCI sends a polite letter. The Presidium notes with concern that the line we follow differs from the one the International requires, which now favours [+ md_fav_name +]. We lose 5 trust. ?]
[? if md_step = 2 : The Comintern's subsidy is stopped. A letter says that the funds will be made available again when the party line is brought into agreement with the International. We lose 5 trust and the subsidy. ?]
[? if md_step = 3 : Moscow sends its representatives to speak to the district leaders directly. They back [+ md_fav_name +], and the party's own leadership learns that its authority runs only as far as Moscow permits. [+ md_fav_name +] gain 5 strength; the faction in power gains 10 dissent. ?]
[? if md_step = 4 : An Open Letter from the ECCI is published in the party press, addressed to the membership over the head of its leaders. It calls the present leadership a danger to the party. The faction in power gains 15 dissent and we lose 10 trust. ?]
[? if md_step >= 5 : The ECCI dissolves the Central Committee's majority. [+ md_old_name +] are removed from the leadership by decree, and [+ md_fav_name +] take their place as the Comintern's candidates. No vote of the delegates would have changed this. ?]

[? if md_step < 5 : The step is eased as soon as our line matches Moscow's, or when the balance of power in Moscow moves in our favour and a different faction becomes the favoured one. Steps cannot be talked down by words alone. ?]

- @root: Continue.
