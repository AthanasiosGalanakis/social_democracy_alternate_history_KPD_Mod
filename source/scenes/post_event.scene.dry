title: Post Event
new-page: true
on-arrival: {!
Q.last_advisor_action = 0;
// recompute support and factions, and move the clock if an action was taken (out/html/kpd.js)
window.KPD.postEvent(Q);
// is there an event waiting? Then show it before the hand.
Q.has_event = 0;
var choices = this._compileChoices(this.game.scenes['post_event.events_choice']);
if (choices && choices.length && choices[0].title != "Continue...") {
    Q.has_event = 1;
}
!}
go-to: events_choice if has_event = 1; main if has_event = 0

= [+ date_label +]

@events_choice

- #kpd_event

# This scene only updates the numbers after events and cards, and routes to waiting events.
